@import "tailwindcss";
@import "tw-animate-css";
@import "shadcn/tailwind.css";
@import "@fontsource-variable/inter";

@custom-variant dark (&:is(.dark *, [data-theme="dark"] *));

html {
  font-size: 92.5%;
}

@theme inline {
  /* ─── Type ─────────────────────────────────────────────── */
  --font-heading: var(--font-sans);
  --font-sans: "Inter Variable", "Inter", system-ui, -apple-system, sans-serif;
  --font-serif: "Source Serif 4", Georgia, serif;
  --font-mono: "JetBrains Mono", ui-monospace, Menlo, monospace;

  --text-display: 3.5rem;
  --text-h1: 2.5rem;
  --text-h2: 1.75rem;
  --text-h3: 1.25rem;
  --text-lg: 1.125rem;
  --text-base: 1rem;
  --text-sm: 0.9375rem;
  --text-xs: 0.8125rem;
  --text-micro: 0.6875rem;

  /* ─── shadcn / Tailwind semantic colors ────────────────── */
  --color-background: var(--background);
  --color-foreground: var(--foreground);

  --color-card: var(--card);
  --color-card-foreground: var(--card-foreground);

  --color-popover: var(--popover);
  --color-popover-foreground: var(--popover-foreground);

  --color-primary: var(--primary);
  --color-primary-foreground: var(--primary-foreground);

  --color-secondary: var(--secondary);
  --color-secondary-foreground: var(--secondary-foreground);

  --color-muted: var(--muted);
  --color-muted-foreground: var(--muted-foreground);

  --color-accent: var(--accent);
  --color-accent-foreground: var(--accent-foreground);

  --color-destructive: var(--destructive);
  --color-destructive-foreground: var(--destructive-foreground);

  --color-border: var(--border);
  --color-input: var(--input);
  --color-ring: var(--ring);

  /* ─── Sidebar ──────────────────────────────────────────── */
  --color-sidebar: var(--sidebar);
  --color-sidebar-foreground: var(--sidebar-foreground);
  --color-sidebar-primary: var(--sidebar-primary);
  --color-sidebar-primary-foreground: var(--sidebar-primary-foreground);
  --color-sidebar-accent: var(--sidebar-accent);
  --color-sidebar-accent-foreground: var(--sidebar-accent-foreground);
  --color-sidebar-border: var(--sidebar-border);
  --color-sidebar-ring: var(--sidebar-ring);

  /* ─── Charts ───────────────────────────────────────────── */
  --color-chart-1: var(--chart-1);
  --color-chart-2: var(--chart-2);
  --color-chart-3: var(--chart-3);
  --color-chart-4: var(--chart-4);
  --color-chart-5: var(--chart-5);

  /* ─── Legacy GTmedic aliases ─────────────────────────────
   * Mantém compatibilidade com classes antigas como:
   * bg-bg, bg-surface, text-text-2, bg-accent-tint etc.
   */
  --color-bg: var(--background);
  --color-surface: var(--card);
  --color-surface-2: var(--secondary);
  --color-surface-3: var(--surface-3);

  --color-border-hi: var(--border-hi);

  --color-text: var(--foreground);
  --color-text-2: var(--text-2);
  --color-text-3: var(--text-3);
  --color-text-4: var(--text-4);

  --color-brand: var(--primary);
  --color-brand-fg: var(--primary-foreground);

  --color-accent-tint: var(--accent);
  --color-accent-border: var(--primary);

  --color-success: var(--success);
  --color-success-bg: var(--success-bg);

  --color-warn: var(--warn);
  --color-warn-bg: var(--warn-bg);

  --color-danger: var(--destructive);
  --color-danger-bg: var(--danger-bg);

  /* ─── Radius ───────────────────────────────────────────── */
  --radius-sm: calc(var(--radius) * 0.6);
  --radius-md: calc(var(--radius) * 0.8);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) * 1.4);
  --radius-2xl: calc(var(--radius) * 1.8);
  --radius-3xl: calc(var(--radius) * 2.2);
  --radius-4xl: calc(var(--radius) * 2.6);
  --radius-card: 4px;

  /* ─── Elevation ────────────────────────────────────────── */
  --shadow-s1: 0 1px 2px rgb(28 26 23 / 0.04), 0 0 0 1px rgb(28 26 23 / 0.06);
  --shadow-s2: 0 1px 3px rgb(28 26 23 / 0.05), 0 4px 12px rgb(28 26 23 / 0.04);
  --shadow-s3:
    0 4px 12px rgb(28 26 23 / 0.08), 0 16px 40px rgb(28 26 23 / 0.06);
  --shadow-s4:
    0 12px 24px rgb(28 26 23 / 0.12), 0 32px 64px rgb(28 26 23 / 0.08);
}

/* ─── Light mode — GTmedic original palette ───────────────── */
:root,
[data-theme="light"] {
  --background: #fafaf9;
  --foreground: #1c1917;

  --card: #ffffff;
  --card-foreground: #1c1917;

  --popover: #ffffff;
  --popover-foreground: #1c1917;

  --primary: #3d5a80;
  --primary-foreground: #ffffff;

  --secondary: #f5f5f4;
  --secondary-foreground: #44403c;

  --muted: #f5f5f4;
  --muted-foreground: #78716c;

  /*
   * shadcn usa "accent" para hover/seleção leve.
   * Por isso aqui ele recebe o tint do azul-aço, não a cor forte.
   */
  --accent: #eaf0f8;
  --accent-foreground: #1c1917;

  --destructive: #8a3a2f;
  --destructive-foreground: #ffffff;

  --border: #e7e5e4;
  --border-hi: #d6d3d1;
  --input: #e7e5e4;
  --ring: #3d5a80;

  --surface-3: #efefec;

  --text-2: #44403c;
  --text-3: #78716c;
  --text-4: #a8a29e;

  --success: #3a6b5a;
  --success-bg: #e8f1ec;

  --warn: #7b5a2a;
  --warn-bg: #f8efe0;

  --danger-bg: #f5e3df;

  --chart-1: #3d5a80;
  --chart-2: #3a6b5a;
  --chart-3: #7b5a2a;
  --chart-4: #8a3a2f;
  --chart-5: #78716c;

  --radius: 0.625rem;

  --sidebar: #ffffff;
  --sidebar-foreground: #1c1917;
  --sidebar-primary: #3d5a80;
  --sidebar-primary-foreground: #ffffff;
  --sidebar-accent: #eaf0f8;
  --sidebar-accent-foreground: #1c1917;
  --sidebar-border: #e7e5e4;
  --sidebar-ring: #3d5a80;
}

/* ─── Dark mode — GTmedic original palette ────────────────── */
.dark,
[data-theme="dark"] {
  --background: #0e0d0c;
  --foreground: #f5f3f0;

  --card: #161513;
  --card-foreground: #f5f3f0;

  --popover: #161513;
  --popover-foreground: #f5f3f0;

  --primary: #3d5a80;
  --primary-foreground: #ffffff;

  --secondary: #1c1a18;
  --secondary-foreground: #f5f3f0;

  --muted: #1c1a18;
  --muted-foreground: #928b84;

  --accent: #1a2433;
  --accent-foreground: #f5f3f0;

  --destructive: #8a3a2f;
  --destructive-foreground: #ffffff;

  --border: #2a2724;
  --border-hi: #3a3633;
  --input: #2a2724;
  --ring: #3d5a80;

  --surface-3: #26231f;

  --text-2: #c8c3be;
  --text-3: #928b84;
  --text-4: #6b645e;

  --success: #3a6b5a;
  --success-bg: #173b2c;

  --warn: #7b5a2a;
  --warn-bg: #3a2a14;

  --danger-bg: #3a1810;

  --chart-1: #3d5a80;
  --chart-2: #3a6b5a;
  --chart-3: #7b5a2a;
  --chart-4: #8a3a2f;
  --chart-5: #928b84;

  --sidebar: #161513;
  --sidebar-foreground: #f5f3f0;
  --sidebar-primary: #3d5a80;
  --sidebar-primary-foreground: #ffffff;
  --sidebar-accent: #1a2433;
  --sidebar-accent-foreground: #f5f3f0;
  --sidebar-border: #2a2724;
  --sidebar-ring: #3d5a80;
}

/* ─── Accent variants ─────────────────────────────────────── */
[data-accent="azul-aco"] {
  --primary: #3d5a80;
  --primary-foreground: #ffffff;
  --accent: #eaf0f8;
  --accent-foreground: #1c1917;
  --ring: #3d5a80;

  --sidebar-primary: #3d5a80;
  --sidebar-primary-foreground: #ffffff;
  --sidebar-accent: #eaf0f8;
  --sidebar-accent-foreground: #1c1917;
  --sidebar-ring: #3d5a80;
}

.dark[data-accent="azul-aco"],
[data-theme="dark"][data-accent="azul-aco"] {
  --accent: #1a2433;
  --accent-foreground: #f5f3f0;

  --sidebar-accent: #1a2433;
  --sidebar-accent-foreground: #f5f3f0;
}

[data-accent="verde-petroleo"] {
  --primary: #3a6b5a;
  --primary-foreground: #ffffff;
  --accent: #e8f1ec;
  --accent-foreground: #1c1917;
  --ring: #3a6b5a;

  --sidebar-primary: #3a6b5a;
  --sidebar-primary-foreground: #ffffff;
  --sidebar-accent: #e8f1ec;
  --sidebar-accent-foreground: #1c1917;
  --sidebar-ring: #3a6b5a;
}

.dark[data-accent="verde-petroleo"],
[data-theme="dark"][data-accent="verde-petroleo"] {
  --accent: #15211c;
  --accent-foreground: #f5f3f0;

  --sidebar-accent: #15211c;
  --sidebar-accent-foreground: #f5f3f0;
}

[data-accent="vermelho-tijolo"] {
  --primary: #8a3a2f;
  --primary-foreground: #ffffff;
  --accent: #f5e9e6;
  --accent-foreground: #1c1917;
  --ring: #8a3a2f;

  --sidebar-primary: #8a3a2f;
  --sidebar-primary-foreground: #ffffff;
  --sidebar-accent: #f5e9e6;
  --sidebar-accent-foreground: #1c1917;
  --sidebar-ring: #8a3a2f;
}

.dark[data-accent="vermelho-tijolo"],
[data-theme="dark"][data-accent="vermelho-tijolo"] {
  --accent: #2a1110;
  --accent-foreground: #f5f3f0;

  --sidebar-accent: #2a1110;
  --sidebar-accent-foreground: #f5f3f0;
}

/* ─── Base ────────────────────────────────────────────────── */
@layer base {
  * {
    @apply border-border outline-ring/50;
  }

  html {
    @apply font-sans;
  }

  body {
    @apply bg-background text-foreground;
    -webkit-font-smoothing: antialiased;
  }

  button:not(:disabled),
  [role="button"]:not(:disabled) {
    cursor: pointer;
  }
}

/* ─── Utilities ───────────────────────────────────────────── */
.font-serif {
  font-family: var(--font-serif);
}

.font-mono {
  font-family: var(--font-mono);
}

@keyframes blink {
  0%,
  49% {
    opacity: 1;
  }

  50%,
  100% {
    opacity: 0;
  }
}

.cursor-blink {
  animation: blink 1s infinite;
}
